# Database Configuration
POSTGRES_USER=erp
POSTGRES_PASSWORD=change_this_to_secure_password
POSTGRES_DB=erp
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Backend Configuration
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Required, no default — the backend refuses to start without it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Security
# Comma-separated list of allowed origins (e.g. http://localhost:3000,https://my-erp.com)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3030
# Optional regex of extra allowed origins, for a host-agnostic frontend build whose
# origin follows the LAN address (see NEXT_PUBLIC_API_BASE below).
# BACKEND_CORS_ORIGIN_REGEX=^http://(172\.16\.\d+\.\d+|terras-srv\.local|localhost)(:\d+)?$

# Frontend Configuration (Public)
# The public URL of your backend API. 
# For local dev: http://localhost:8000
# Backend URL for the frontend. With or without the /api suffix — the frontend
# normalizes it (components/shared/apiBase.ts). Leave empty for an on-prem box
# with a moving IP: the frontend then calls port 8000 on whatever host served it.
NEXT_PUBLIC_API_BASE=http://localhost:8000